// Aranyak Jewellers Prisma Schema
// Reused and adapted from SBD_SOLUTION

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// USER MANAGEMENT
// --------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  USER
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String?   @unique
  password  String?
  mobile    String?   
  name      String
  role      Role      @default(USER)
  googleId  String?
  avatar    String?
  
  // Advanced Auth Fields
  totpSecret       String?
  totpEnabled      Boolean   @default(false)
  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  cart      Cart?
  orders    Order[]
  wishlist  Wishlist[]
  addresses Address[] 
}

// --------------------------------------
// MASTER DATA
// --------------------------------------

model GoldPrice {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  purity      Int      @unique // e.g. 22
  pricePer10g Float
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// --------------------------------------
// PRODUCTS
// --------------------------------------

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  nameBn      String?
  slug        String   @unique
  description String?
  descriptionBn String?
  
  // Core Specs
  goldPurity  Int      // 18, 22, 24
  goldWeight  Float    // grams
  
  diamondClarity String? // "VS1", "VVS1", "SI"
  diamondCarat   Float?
  diamondCut     String?
  diamondColor   String?
  
  category    String   
  subCategory String?
  tags        String[] 
  
  // Flexible Jewellery Details
  metalType    String   @default("GOLD") // "GOLD", "DIAMOND", "SILVER", "PLATINUM", "GEMSTONE"
  grossWeight  Float?
  stoneWeight  Float?
  stoneDetails String?
  priceType    String   @default("CALCULATED") // "FIXED", "CALCULATED", "INQUIRE"
  fixedPrice   Float?
  makingCharge Float?
  stockStatus  String   @default("IN_STOCK") // "IN_STOCK", "MADE_TO_ORDER", "OUT_OF_STOCK"
  isFeatured   Boolean  @default(false)
  isNewArrival Boolean  @default(false)
  
  // Media
  images      String[] 
  coverImage  String?  
  
  isActive    Boolean  @default(true)
  stockCount  Int      @default(0)
  sku         String?  @unique
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  cartItems   CartItem[]
  orderItems  OrderItem[]
  wishlistedBy Wishlist[]

  @@index([category, isActive])
  @@index([isFeatured, isActive])
}

model Category {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String   @unique
  slug           String   @unique
  parentId       String?  @db.ObjectId // For nesting
  imageUrl       String?
  bannerUrl      String?
  description    String?
  isFeatured     Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  isActive       Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// --------------------------------------
// E-COMMERCE CORE
// --------------------------------------

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?    @unique @db.ObjectId 
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId    String   @db.ObjectId
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  userId          String?     @db.ObjectId
  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]
  totalAmount     Float
  status          String      @default("PENDING")
  paymentStatus   String      @default("PENDING")
  shippingAddress AddressType
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String  @db.ObjectId
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  name      String  
  quantity  Int
  price     Float   
}

type AddressType {
  fullName  String
  street    String
  city      String
  state     String
  zip       String
  phone     String
}

model Address {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  fullName  String
  street    String
  city      String
  state     String
  zip       String
  phone     String
  isDefault Boolean  @default(false)
}

model Banner {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl       String
  link           String?
  title          String?
  isActive       Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// --------------------------------------
// DYNAMIC SITE SETTINGS & STORES
// --------------------------------------

model SiteSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Store {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  address   String
  phone     String
  mapUrl    String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteMedia {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  key           String   @unique
  section       String
  title         String
  altText       String?
  url           String
  previousUrl   String?
  usageLocation String?
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([section, isActive])
}

// --------------------------------------
// PROMOTIONAL OFFERS & ANNOUNCEMENTS
// --------------------------------------

model PromotionalOffer {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  titleEn       String
  titleBn       String
  descEn        String?
  descBn        String?
  tag           String    // e.g. "₹1000 OFF/GM", "ZERO LOSS EXCHANGE"
  badge         String?   // e.g. "Festive", "Exclusive", "Bumper"
  icon          String?   // e.g. "coins", "diamond", "percent", "gift", "sparkles"
  imageUrl      String?
  discountValue String?   // e.g. "1000", "25%"
  discountType  String?   // "FLAT", "PERCENT", "FREE_MAKING", "GIFT"
  terms         String?
  startDate     DateTime?
  endDate       DateTime?
  placement     String    @default("both") // "cards", "ticker", "both"
  highlight     Boolean   @default(false)
  isActive      Boolean   @default(true)
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive, order])
}

model TickerMessage {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  textBn         String
  textEn         String?
  linkedOfferId  String?   @db.ObjectId
  startDate      DateTime?
  endDate        DateTime?
  speed          Int       @default(40)
  direction      String    @default("rtl")
  separator      String    @default("—")
  isActive       Boolean   @default(true)
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, order])
}

model GalleryItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  subtitle    String?
  description String?
  imageUrl    String
  category    String   // "bridal", "necklaces", "bangles", "solitaires", "silver", "heritage", "showrooms"
  metal       String?  // "gold", "silver", "diamond", "gemstone"
  purity      String?  // "22K", "18K", "925"
  tags        String[]
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isActive, order])
}
